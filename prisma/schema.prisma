generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts              Account[]
  sessions              Session[]
  memberships           OrganizationMember[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  uploadedDocs          Document[]
  preparedTaxReturns    TaxReturn[]          @relation("TaxReturnPreparer")
  reviewedTaxReturns    TaxReturn[]          @relation("TaxReturnReviewer")
  approvedTaxReturns    TaxReturn[]          @relation("TaxReturnApprover")
  filedTaxReturns       TaxReturn[]          @relation("TaxReturnFiler")
  taxReturnReviews      TaxReturnReview[]
  taxReturnDocuments    TaxReturnDocument[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ORGANIZATION ────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  phone       String?
  email       String?
  address     String?
  plan        OrgPlan  @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members          OrganizationMember[]
  businesses       Business[]
  settings         OrganizationSetting[]
  taxReturns       TaxReturn[]
  documents        Document[]
  taxDocuments     TaxReturnDocument[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole       @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationSetting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ─── BUSINESS ────────────────────────────────────────────────────────────────

model Business {
  id               String         @id @default(cuid())
  organizationId   String
  legalName        String
  tradingName      String?
  businessType     BusinessType
  industry         String?
  pacraNumber      String?
  tpin             String?
  napsaEmployerNo  String?
  nhimaEmployerNo  String?
  vatNumber        String?
  physicalAddress  String?
  postalAddress    String?
  phone            String?
  email            String?
  website          String?
  country          String         @default("ZM")
  status           BusinessStatus @default(ACTIVE)
  incorporatedDate DateTime?
  financialYearEnd Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees            Employee[]
  obligations          ComplianceObligation[]
  businessRequirements BusinessRequirement[]
  payments             Payment[]
  documents            Document[]
  directors            Director[]
  shareholders         Shareholder[]
  payrolls             Payroll[]
  auditLogs            AuditLog[]
  reminders            Reminder[]
  submissions          Submission[]
  taxReturns           TaxReturn[]
  fixedAssets          FixedAsset[]
  taxLosses            TaxLoss[]
  taxReturnDocuments   TaxReturnDocument[]
}

model Director {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  nrc         String?
  email       String?
  phone       String?
  nationality String?
  position    String?
  appointedAt DateTime?
  resignedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Shareholder {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  type            String    @default("individual")
  nrc             String?
  sharesHeld      Int?
  sharePercentage Decimal?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── AUTHORITY & COMPLIANCE ENGINE ───────────────────────────────────────────

model Authority {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  fullName     String?
  description  String?
  website      String?
  contactEmail String?
  contactPhone String?
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requirements ComplianceRequirement[]
  rules        AuthorityRule[]
  obligations  ComplianceObligation[]
  submissions  Submission[]
  payments     Payment[]
  documents    Document[]
}

model ComplianceRequirement {
  id                   String               @id @default(cuid())
  authorityId          String
  code                 String
  name                 String
  description          String?
  frequency            RequirementFrequency
  applicableTo         String[]
  defaultDueDayOfMonth Int?
  defaultDueDayOfYear  String?
  gracePeriodDays      Int                  @default(0)
  active               Boolean              @default(true)
  mandatory            Boolean              @default(true)
  category             String?
  notes                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  authority            Authority            @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  businessRequirements BusinessRequirement[]
  obligations          ComplianceObligation[]

  @@unique([authorityId, code])
}

model BusinessRequirement {
  id            String    @id @default(cuid())
  businessId    String
  requirementId String
  enabled       Boolean   @default(true)
  customDueDays Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([businessId, requirementId])
}

model ComplianceObligation {
  id            String           @id @default(cuid())
  businessId    String
  authorityId   String
  requirementId String
  title         String
  periodLabel   String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  status        ObligationStatus @default(UPCOMING)
  amountDue     Decimal?
  currency      String           @default("ZMW")
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authority     Authority             @relation(fields: [authorityId], references: [id])
  requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id])
  submissions   Submission[]
  payments      Payment[]
  documents     Document[]
  reminders     Reminder[]
  auditLogs     AuditLog[]
}

// ─── SUBMISSION ───────────────────────────────────────────────────────────────

model Submission {
  id             String           @id @default(cuid())
  businessId     String
  authorityId    String
  obligationId   String?
  referenceNo    String?
  submittedAt    DateTime?
  submittedBy    String?
  method         String?
  status         SubmissionStatus @default(DRAFT)
  channel        String?
  confirmationNo String?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authority  Authority             @relation(fields: [authorityId], references: [id])
  obligation ComplianceObligation? @relation(fields: [obligationId], references: [id])
  documents  Document[]
}

// ─── PAYMENT ─────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  businessId    String
  authorityId   String
  obligationId  String?
  description   String
  amount        Decimal
  currency      String        @default("ZMW")
  paidAt        DateTime?
  paymentMethod String?
  referenceNo   String?
  bankName      String?
  branchName    String?
  status        PaymentStatus @default(PENDING)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authority  Authority             @relation(fields: [authorityId], references: [id])
  obligation ComplianceObligation? @relation(fields: [obligationId], references: [id])
  receipts   Document[]
}

// ─── EMPLOYEE ─────────────────────────────────────────────────────────────────

model Employee {
  id               String         @id @default(cuid())
  businessId       String
  employeeNo       String?
  firstName        String
  lastName         String
  nrc              String?
  dob              DateTime?
  gender           String?
  phone            String?
  email            String?
  address          String?
  jobTitle         String?
  department       String?
  employedAt       DateTime?
  terminatedAt     DateTime?
  status           EmployeeStatus @default(ACTIVE)
  basicSalary      Decimal?
  currency         String         @default("ZMW")
  napsaNumber      String?
  nhimaNumber      String?
  tpin             String?
  bankName         String?
  bankAccountNo    String?
  bankSortCode     String?
  emergencyContact String?
  emergencyPhone   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@unique([businessId, employeeNo])
}

// ─── PAYROLL ─────────────────────────────────────────────────────────────────

model Payroll {
  id          String        @id @default(cuid())
  businessId  String
  periodLabel String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  totalGross  Decimal       @default(0)
  totalNapsa  Decimal       @default(0)
  totalNhima  Decimal       @default(0)
  totalPaye   Decimal       @default(0)
  totalNet    Decimal       @default(0)
  processedAt DateTime?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    PayrollItem[]
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollId       String
  employeeId      String
  basicSalary     Decimal  @default(0)
  allowances      Decimal  @default(0)
  grossSalary     Decimal  @default(0)
  napsaEmployee   Decimal  @default(0)
  napsaEmployer   Decimal  @default(0)
  nhimaEmployee   Decimal  @default(0)
  nhimaEmployer   Decimal  @default(0)
  paye            Decimal  @default(0)
  otherDeductions Decimal  @default(0)
  netSalary       Decimal  @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
}

// ─── DOCUMENT ─────────────────────────────────────────────────────────────────

model Document {
  id              String           @id @default(cuid())
  organizationId  String
  businessId      String
  authorityId     String?
  obligationId    String?
  submissionId    String?
  paymentId       String?
  uploadedById    String
  name            String
  description     String?
  category        DocumentCategory @default(OTHER)
  mimeType        String?
  size            Int?
  url             String?
  blobUrl         String?
  expiryDate      DateTime?
  periodLabel     String?
  status          DocumentStatus   @default(ACTIVE)
  versionNumber   Int              @default(1)
  versionOf       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id])
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authority    Authority?            @relation(fields: [authorityId], references: [id])
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id])
  submission   Submission?           @relation(fields: [submissionId], references: [id])
  payment      Payment?              @relation(fields: [paymentId], references: [id])
  uploadedBy   User                  @relation(fields: [uploadedById], references: [id])
  parent       Document?             @relation("DocumentVersions", fields: [versionOf], references: [id])
  versions     Document[]            @relation("DocumentVersions")

  @@index([organizationId, businessId])
  @@index([organizationId, deletedAt])
}

// ─── REMINDERS & NOTIFICATIONS ───────────────────────────────────────────────

model Reminder {
  id           String         @id @default(cuid())
  businessId   String
  obligationId String?
  title        String
  message      String?        @db.Text
  dueDate      DateTime
  scheduledAt  DateTime
  sentAt       DateTime?
  status       ReminderStatus @default(PENDING)
  channel      String         @default("in_app")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  obligation ComplianceObligation? @relation(fields: [obligationId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  readAt    DateTime?
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── STATUTORY RULES ─────────────────────────────────────────────────────────

model AuthorityRule {
  id            String    @id @default(cuid())
  authorityId   String
  name          String
  description   String?
  ruleType      String
  value         String    @db.Text
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String?
  notes         String?   @db.Text
  active        Boolean   @default(true)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authority Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
}

model TaxRule {
  id            String      @id @default(cuid())
  name          String
  taxType       String
  description   String?
  brackets      Json?
  flatRate      Decimal?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String?
  notes         String?     @db.Text
  active        Boolean     @default(true)
  verifiedAt    DateTime?
  isDraft       Boolean     @default(false)
  approvedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  taxReturns TaxReturn[]
}

model ContributionRule {
  id               String    @id @default(cuid())
  name             String
  contributionType String
  description      String?
  employeeRate     Decimal?
  employerRate     Decimal?
  ceiling          Decimal?
  floor            Decimal?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  source           String?
  notes            String?   @db.Text
  active           Boolean   @default(true)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── TAX PREPARATION ─────────────────────────────────────────────────────────

model TaxReturn {
  id                 String          @id @default(cuid())
  organizationId     String
  businessId         String
  taxType            TaxReturnType
  taxYear            Int
  periodStart        DateTime
  periodEnd          DateTime
  financialYearStart DateTime?
  financialYearEnd   DateTime?
  referenceNo        String?
  status             TaxReturnStatus @default(DRAFT)
  preparerId         String?
  reviewerId         String?
  approvedAt         DateTime?
  approvedById       String?
  submittedAt        DateTime?
  submissionRef      String?
  filedById          String?
  filingReceipt      String?
  paymentRef         String?
  paymentDate        DateTime?
  taxRuleId          String?
  version            Int             @default(1)
  isAmended          Boolean         @default(false)
  amendedFromId      String?
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization    Organization              @relation(fields: [organizationId], references: [id])
  business        Business                  @relation(fields: [businessId], references: [id])
  preparer        User?                     @relation("TaxReturnPreparer", fields: [preparerId], references: [id])
  reviewer        User?                     @relation("TaxReturnReviewer", fields: [reviewerId], references: [id])
  approvedBy      User?                     @relation("TaxReturnApprover", fields: [approvedById], references: [id])
  filedBy         User?                     @relation("TaxReturnFiler", fields: [filedById], references: [id])
  taxRule         TaxRule?                  @relation(fields: [taxRuleId], references: [id])
  amendedFrom     TaxReturn?                @relation("TaxReturnAmendments", fields: [amendedFromId], references: [id])
  amendments      TaxReturn[]               @relation("TaxReturnAmendments")
  balanceSheet    TaxReturnBalanceSheet?
  incomeStatement TaxReturnIncomeStatement?
  computation     TaxReturnComputation?
  fixedAssets     FixedAsset[]
  taxAdjustments  TaxAdjustment[]
  taxLosses       TaxLoss[]
  documents       TaxReturnDocument[]
  reviews         TaxReturnReview[]

  @@unique([businessId, taxType, taxYear, version])
  @@index([organizationId])
  @@index([businessId])
  @@index([status])
}

model TaxReturnBalanceSheet {
  id                         String    @id @default(cuid())
  taxReturnId                String    @unique

  // Non-current assets
  ppe                        Decimal   @default(0)
  intangibleAssets           Decimal   @default(0)
  longTermInvestments        Decimal   @default(0)
  otherNonCurrentAssets      Decimal   @default(0)
  totalNonCurrentAssets      Decimal   @default(0)

  // Current assets
  inventory                  Decimal   @default(0)
  tradeReceivables           Decimal   @default(0)
  otherReceivables           Decimal   @default(0)
  cashAndBank                Decimal   @default(0)
  otherCurrentAssets         Decimal   @default(0)
  totalCurrentAssets         Decimal   @default(0)

  totalAssets                Decimal   @default(0)

  // Current liabilities
  tradePayables              Decimal   @default(0)
  taxLiabilitiesCurrent      Decimal   @default(0)
  currentBorrowings          Decimal   @default(0)
  otherCurrentLiabilities    Decimal   @default(0)
  totalCurrentLiabilities    Decimal   @default(0)

  // Non-current liabilities
  longTermBorrowings         Decimal   @default(0)
  deferredTax                Decimal   @default(0)
  otherNonCurrentLiabilities Decimal   @default(0)
  totalNonCurrentLiabilities Decimal   @default(0)

  totalLiabilities           Decimal   @default(0)

  // Equity
  shareCapital               Decimal   @default(0)
  sharePremium               Decimal   @default(0)
  retainedEarnings           Decimal   @default(0)
  otherEquity                Decimal   @default(0)
  totalEquity                Decimal   @default(0)

  totalLiabilitiesAndEquity  Decimal   @default(0)

  updatedAt                  DateTime  @updatedAt

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model TaxReturnIncomeStatement {
  id                   String    @id @default(cuid())
  taxReturnId          String    @unique

  turnover             Decimal   @default(0)
  otherOperatingIncome Decimal   @default(0)
  totalRevenue         Decimal   @default(0)

  costOfSales          Decimal   @default(0)
  grossProfit          Decimal   @default(0)

  adminExpenses        Decimal   @default(0)
  sellingExpenses      Decimal   @default(0)
  depreciation         Decimal   @default(0)
  financeCharges       Decimal   @default(0)
  otherExpenses        Decimal   @default(0)
  totalExpenses        Decimal   @default(0)

  profitBeforeTax      Decimal   @default(0)
  taxExpense           Decimal   @default(0)
  profitAfterTax       Decimal   @default(0)

  updatedAt            DateTime  @updatedAt

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model TaxReturnComputation {
  id                      String    @id @default(cuid())
  taxReturnId             String    @unique

  accountingProfit        Decimal   @default(0)

  // Addbacks (disallowable expenses)
  addbackDepreciation     Decimal   @default(0)
  addbackEntertainment    Decimal   @default(0)
  addbackFines            Decimal   @default(0)
  addbackOther            Decimal   @default(0)
  totalAddbacks           Decimal   @default(0)

  // Allowable deductions
  capitalAllowances       Decimal   @default(0)
  otherAllowableDeductions Decimal  @default(0)
  totalDeductions         Decimal   @default(0)

  // Losses
  lossesUtilised          Decimal   @default(0)

  taxableProfit           Decimal   @default(0)

  // Tax calculation
  taxRate                 Decimal   @default(0)
  grossTaxLiability       Decimal   @default(0)

  // Credits
  taxCredits              Decimal   @default(0)
  advanceTaxPaid          Decimal   @default(0)
  whtCredits              Decimal   @default(0)
  totalCredits            Decimal   @default(0)

  netTaxPayable           Decimal   @default(0)
  taxRefundable           Decimal   @default(0)

  taxRuleSnapshot         Json?

  notes                   String?   @db.Text
  updatedAt               DateTime  @updatedAt

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model FixedAsset {
  id                     String                   @id @default(cuid())
  taxReturnId            String
  businessId             String
  description            String
  assetCategory          CapitalAllowanceCategory
  acquisitionDate        DateTime?
  acquisitionCost        Decimal                  @default(0)
  businessUsePercent     Decimal                  @default(100)
  qualifyingCost         Decimal                  @default(0)
  disposalDate           DateTime?
  disposalProceeds       Decimal?
  taxWdvBrought          Decimal                  @default(0)
  allowanceRate          Decimal                  @default(0)
  calculatedAllowance    Decimal                  @default(0)
  taxWdvCarried          Decimal                  @default(0)
  accountingDepreciation Decimal                  @default(0)
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id])
}

model TaxAdjustment {
  id          String   @id @default(cuid())
  taxReturnId String
  type        String   // "ADDBACK" | "DEDUCTION"
  description String
  amount      Decimal  @default(0)
  reference   String?
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model TaxLoss {
  id             String    @id @default(cuid())
  businessId     String
  taxReturnId    String?
  taxYear        Int
  originalAmount Decimal   @default(0)
  utilisedAmount Decimal   @default(0)
  status         String    @default("AVAILABLE")
  expiresYear    Int?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  taxReturn TaxReturn? @relation(fields: [taxReturnId], references: [id])
}

model TaxReturnDocument {
  id             String              @id @default(cuid())
  organizationId String
  taxReturnId    String
  businessId     String
  uploadedById   String
  name           String
  description    String?
  category       TaxDocumentCategory @default(OTHER_SUPPORTING)
  taxYear        Int?
  mimeType       String?
  size           Int?
  url            String?
  blobUrl        String?
  versionNumber  Int                 @default(1)
  versionOf      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  taxReturn    TaxReturn          @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
  business     Business           @relation(fields: [businessId], references: [id])
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  parent       TaxReturnDocument? @relation("TaxReturnDocumentVersions", fields: [versionOf], references: [id])
  versions     TaxReturnDocument[] @relation("TaxReturnDocumentVersions")

  @@index([organizationId, taxReturnId])
  @@index([organizationId, deletedAt])
}

model TaxReturnReview {
  id          String                @id @default(cuid())
  taxReturnId String
  reviewerId  String
  action      TaxReturnReviewAction
  notes       String?               @db.Text
  createdAt   DateTime              @default(now())

  taxReturn TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
  reviewer  User      @relation(fields: [reviewerId], references: [id])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  userId         String?
  organizationId String?
  businessId     String?
  obligationId   String?
  taxReturnId    String?
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  description    String?
  createdAt      DateTime  @default(now())

  user       User?                 @relation(fields: [userId], references: [id])
  business   Business?             @relation(fields: [businessId], references: [id])
  obligation ComplianceObligation? @relation(fields: [obligationId], references: [id])
}

